    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/yilinzhou/Desktop/中证1000择时/logs/daily.log</string>
  <key>StandardErrorPath</key><string>/Users/yilinzhou/Desktop/中证1000择时/logs/daily.log</string>
